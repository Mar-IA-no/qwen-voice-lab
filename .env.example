# Runtime
QVL_ENGINE=mock
QVL_DATA_DIR=./data
QVL_HOST=127.0.0.1
QVL_PORT=8788

# Qwen local (set QVL_ENGINE=qwen and launch with scripts/run_gpu.sh)
QVL_QWEN_BASE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
QVL_QWEN_DESIGN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
QVL_QWEN_BASE_MODEL_LABEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
QVL_QWEN_DESIGN_MODEL_LABEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
QVL_DEVICE=cuda:0
QVL_REQUIRE_GPU_WRAPPER=false
QVL_GPU_WRAPPER=
QVL_GPU_JOBS_DIR=
QVL_GPU_JOB_NAME=qwen-voice-lab
QVL_GPU_CGROUP_PATTERN=
QVL_GPU_UNIT_PREFIX=
QVL_MODEL_IDLE_SECONDS=900
QVL_GPU_WORKER_COMMAND=
QVL_GPU_WORKER_START_TIMEOUT_SECONDS=90
QVL_GPU_RETRY_COOLDOWN_SECONDS=60
QVL_GPU_PREEMPT_EXIT_CODE=75
QVL_GPU_RETRYABLE_EXIT_CODES=1,75
QVL_GPU_STOP_COMMAND=
QVL_GPU_STOP_ALL_COMMAND=

# Browser access (required when QVL_HOST is not loopback)
QVL_ACCESS_TOKEN=
QVL_ALLOW_UNAUTHENTICATED_REMOTE=false
QVL_COOKIE_SECURE=false

# Limits
QVL_MAX_UPLOAD_MIB=50
QVL_MAX_TEXT_CHARS=12000
QVL_MAX_SEGMENTS=64
QVL_MAX_COMPARISON_VOICES=5
